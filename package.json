{
  "name": "zhayitong-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "deploy": "npm run build && wrangler deploy",
    "test": "node scripts/test_log.js && python3 -m unittest discover -s scripts -p 'test_diary.py' && python3 scripts/diary.py validate _data/diary.json",
    "check:urls": "node tests/check-urls.mjs",
    "check:feed": "node tests/check-feed.mjs",
    "check:parity": "node tests/check-parity.mjs",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "hast-util-to-string": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@content-collections/core": "^0.15.3",
    "@content-collections/vite": "^0.3.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "node-html-parser": "^9.0.7",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0",
    "zod": "^4.6.7"
  }
}
